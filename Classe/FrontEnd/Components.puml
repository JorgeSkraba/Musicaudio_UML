@startuml

title Diagrama de Classes Components Front-End - Musicáudio

!pragma layout elk

left to right direction

skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 150

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "components" {

    class UserForm <<Vue Component>>
    class UserTable <<Vue Component>>

    class AppHeader <<Vue Component>>

    class CursoCard <<Vue Component>>
    class CursoForm <<Vue Component>>

    class AulaItem <<Vue Component>>
    class AulaForm <<Vue Component>>

    class MaterialItem <<Vue Component>>
    class MaterialForm <<Vue Component>>

    class CarrinhoItem <<Vue Component>>

    class PagamentoForm <<Vue Component>>

    class MatriculaTable <<Vue Component>> 

    class StatusBadge <<Vue Component>> 

}

  'VIEWS -> COMPONENTS
UsersListView --> AppHeader
UsersListView --> UserTable
UserCreateView --> AppHeader
UserEditView --> AppHeader
UserEditView --> UserForm

CursosListView --> AppHeader
CursosListView --> CursoCard
CursoCreateView --> AppHeader
CursoCreateView --> CursoForm
CursoEditView --> AppHeader
CursoEditView --> CursoForm
CursoDetailView --> AppHeader
CursoDetailView --> AulaItem
CursoDetailView --> StatusBadge

AulaCreateView --> AppHeader
AulaCreateView --> AulaForm
AulaEditView --> AppHeader
AulaEditView --> AulaForm
AulaEditView --> MaterialItem

MaterialCreateView --> AppHeader
MaterialCreateView --> MaterialForm
MaterialEditView --> AppHeader
MaterialEditView --> MaterialForm

CarrinhoView --> AppHeader
CarrinhoView --> CarrinhoItem

PagamentoView --> AppHeader
PagamentoView --> PagamentoForm

MeusCursosView --> AppHeader
MeusCursosView --> CursoCard

MatriculasAdminView --> AppHeader
MatriculasAdminView --> MatriculaTable

@enduml