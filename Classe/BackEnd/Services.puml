@startuml
title Diagrama de Classes Services - Musicáudio

!pragma layout elk

skinparam linetype ortho
'skinparam nodesep 120
'skinparam ranksep 100

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false


package "model.service" {

    ' CONTA (unifica antigo UsuarioService + CredencialService)
    interface ContaService {
        +novaConta(dados: ContaRequestDTO): ContaResponseDTO
        +novaContaComoAdmin(dados: ContaRequestDTO): ContaResponseDTO
        +getContasAtivas(page: int, size: int, sortBy: String): Page<ContaResponseDTO>
        +getContasDesativadas(page: int, size: int, sortBy: String): Page<ContaResponseDTO>
        +getContaPorId(id: Long): ContaResponseDTO
        +atualizarConta(id: Long, dados: ContaRequestDTO): ContaResponseDTO
        +atualizarMinhaConta(id: Long, dados: ContaRequestDTO): ContaResponseDTO
        +getContaPorEmail(email: String): ContaResponseDTO
        +apagarConta(id: Long): Boolean
    }

    'CURSO
    interface CursoService {
        +criarCurso(emailLogado: String, curso: Curso): Curso
        +getCursosAtivos(page: int, size: int, sortBy: String): Page<Curso>
        +getCursosDesativados(page: int, size: int, sortBy: String): Page<Curso>
        +getCursoPorId(id: Long): Curso
        +getCursosPorUsuario(usuarioId: Long): List<Curso>
        +publicarCurso(id: Long): Curso
        +atualizarCurso(id: Long, cursoAtualizado: Curso, emailLogado: String, admin: boolean): Curso
        +apagarCurso(id: Long, emailLogado: String, admin: boolean): Boolean
    }

     'MODULO 
      interface ModuloService {
        +criarModulo(cursoId: Long, modulo: Modulo): Modulo
        +getModulosPorCurso(cursoId: Long): List<Modulo>
        +getModuloPorId(id: Long): Modulo
        +atualizarModulo(id: Long, modulo: Modulo): Modulo
        +ativarDesativarModulo(id: Long, ativo: boolean): Modulo
        +apagarModulo(id: Long): Boolean
    }

    'AULA
      interface AulaService {
        +criarAula(cursoId: Long, aula: Aula): Aula
        +getAulasPorCurso(cursoId: Long): List<Aula>
        +getAulaPorId(id: Long): Aula
        +getAulasPorModulo(moduloId: Long): List<Aula>
        +atualizarAula(id: Long, aula: Aula): Aula
        +ativarDesativarAula(id: Long, ativo: boolean): Aula
        +apagarAula(id: Long): Boolean
    }

    'MATERIAL
    interface MaterialService {
        +criarMaterial(aulaId: Long, material: Material): Material
        +getMateriaisPorAula(aulaId: Long): List<Material>
        +getMaterialPorId(id: Long): Material
        +atualizarMaterial(id: Long, material: Material): Material
        +ativarDesativarMaterial(id: Long, ativo: boolean): Material
        +apagarMaterial(id: Long): Boolean
    }

    'COMPRA
    interface CompraService {
        +iniciarCompra(usuarioId: Long): Compra
        +adicionarItem(compraId: Long, cursoId: Long): Compra
        +finalizarCompra(compraId: Long): Compra
        +getComprasPorUsuario(usuarioId: Long): List<Compra>
        +getCompraPorId(id: Long): Compra
        +cancelarCompra(id: Long): Boolean
    }

    'PAGAMENTO
    interface PagamentoService {
        +processarPagamento(compraId: Long, pagamento: Pagamento): Pagamento
        +getPagamentoPorId(id: Long): Pagamento
        +getPagamentosPorCompra(compraId: Long): List<Pagamento>
        +atualizarStatusPagamento(id: Long, status: String): Pagamento
        +estornarPagamento(id: Long): Pagamento
    }

    'MATRICULA
    interface MatriculaService {
        +criarMatricula(usuarioId: Long, cursoId: Long): Matricula
        +getMatriculasPorUsuario(usuarioId: Long): List<Matricula>
        +getMatriculaPorId(id: Long): Matricula
        +verificarMatricula(usuarioId: Long, cursoId: Long): boolean
        +ativarDesativarMatricula(id: Long, ativo: boolean): Matricula
        +apagarMatricula(id: Long): Boolean
    }

    class TokenService <<Service>> {
        -secretKey: String
        +gerarToken(subject: String): String
        +validarToken(token: String): String
    }
}

' Services

    'CONTA
ContaServiceImp ....|> ContaService

    'CURSO
CursoServiceImp ....|> CursoService

    'MODULO
ModuloServiceImp ....|> ModuloService

    'AULA
AulaServiceImp ....|> AulaService

    'MATERIAL
MaterialServiceImp ....|> MaterialService

    'COMPRA
CompraServiceImp ....|> CompraService

    'PAGAMENTO
PagamentoServiceImp ...|> PagamentoService
PagamentoServiceImp ----> MatriculaService

    'MATRICULA
MatriculaServiceImp ....|> MatriculaService

@enduml