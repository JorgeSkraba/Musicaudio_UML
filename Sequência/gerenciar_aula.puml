@startuml Gerenciar Aula

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupFontStyle bold
skinparam noteFontSize 11
skinparam ParticipantFontStyle bold

title Diagrama de Sequência - Caso de Uso: Gerenciar Aula\nUsuário Autenticado (Instrutor)\nMusicáudio v1.0

skinparam backgroundColor lightyellow

actor "Usuário" as USR

box "Camada Vue JS" #LightGreen
    boundary "Views JS" as VUE
end box

box "Camada de Segurança" #LightYellow
    participant "SecurityFilter\n(JWT)" as SEC
end box

box "Camada de Controle" #LightBlue
    control "AulaController" as AC
end box

box "Camada de Serviço" #LightPink
    entity "AulaService" as AS
end box

box "Camada de Persistência" #LightGrey
    database "AulaRepository" as AR
    database "CursoRepository" as CR
end box

' ==========================================================
' FA1 - CADASTRAR AULA
' ==========================================================

== FA1: Cadastrar Aula ==
note over USR: Pré-condição: autenticado via JWT,\né dono do curso ao qual a aula pertencerá

USR -> VUE : Criar Aula
activate VUE

VUE -> SEC : POST /aulas/nova/{cursoId}\nAuthorization: Bearer <token>\n{ dados da aula }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> AC : repassa requisição autenticada
        deactivate SEC
        activate AC
    end

    AC -> AS : criarAula(cursoId, aula, idLogado)
    activate AS
        AS -> AS : validarCursoPertencimento\n(cursoId, idLogado, admin=false)

        alt #white S1 — Curso não pertence ao usuário
            AS --> AC : IllegalArgumentException\n("Você não pode alterar um curso\nque não te pertence!")
            AC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Curso pertence ao usuário
            AS -> CR : getReferenceById(cursoId)
            CR --> AS : Curso (referência)
            AS -> AS : aula.setCurso(curso)
            AS -> AR : save(aula)
            AR --> AS : Aula salva
            AS --> AC : Aula
            deactivate AS
            AC --> VUE : 201 Created\n{ AulaResponseDTO }
            deactivate AC
        end
deactivate VUE

== FA2: Listar Minhas Aulas ==

USR -> VUE : Listar Aulas do Curso
activate VUE

VUE -> SEC : GET /aulas/minhas-aulas/{cursoId}\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> AC : repassa requisição autenticada
        deactivate SEC
        activate AC
    end

    AC -> AS : getAulasPorCurso(cursoId, admin=false, idLogado)
    activate AS
        AS -> AS : validarCursoPertencimento\n(cursoId, idLogado, admin=false)

        alt #white S1 — Curso não pertence ao usuário
            AS --> AC : Exception\n("Você não pode alterar um curso\nque não te pertence!")
            AC --> VUE : 500 Internal Server Error\n[sem tratamento no controller]
        else Curso pertence ao usuário
            AS -> AS : session.enableFilter\n("aulaAtivaFilter")
            AS -> AR : findAulaByCurso_Id(cursoId)
            AR --> AS : List<Aula>
            AS --> AC : List<Aula>
            deactivate AS
            AC -> AC : aulas.stream()\n.map(toResponse)
            AC --> VUE : 200 OK\n{ List<AulaResponseDTO> }
            deactivate AC
        end
deactivate VUE

== FA3: Atualizar Minha Aula ==

USR -> VUE : Editar Aula
activate VUE

VUE -> SEC : PUT /aulas/minhas-aulas/{id}\nAuthorization: Bearer <token>\n{ dados atualizados }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> AC : repassa requisição autenticada
        deactivate SEC
        activate AC
    end

    AC -> AS : atualizarAula(id, aulaAtualizada, idLogado, admin=false)
    activate AS
        AS -> AS : validarAulaPertencimento\n(id, idLogado, admin=false)

        alt #white S1 — Aula não pertence ao usuário
            AS --> AC : IllegalAccessException\n("Você só pode remover\nsuas aulas!")
            AC --> VUE : 500 Internal Server Error\n[sem tratamento no controller]
        else Aula pertence ao usuário
            AS -> AS : getAulaPorId(id)
            AS -> AR : findById(id)
            AR --> AS : Optional<Aula>

            alt #white S2 — Aula não encontrada
                AS --> AC : EntityNotFoundException\n("Aula não encontrada!")
                AC --> VUE : 500 Internal Server Error\n[sem tratamento no controller]
            else Aula encontrada
                AS -> AR : save(aula)
                AR --> AS : Aula atualizada
                AS --> AC : Aula
                deactivate AS
                AC --> VUE : 200 OK\n{ AulaResponseDTO }
                deactivate AC
            end
        end
deactivate VUE

== FA4: Remover Minha Aula ==

USR -> VUE : Remover Aula
activate VUE

VUE -> SEC : DELETE /aulas/minhas-aulas/{id}\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> AC : repassa requisição autenticada
        deactivate SEC
        activate AC
    end

    AC -> AS : apagarAula(id, idLogado, admin=false)
    activate AS
        AS -> AS : validarAulaPertencimento\n(id, idLogado, admin=false)
        alt #white S1 — Aula não pertence ao usuário
            AS --> AC : IllegalAccessException\n("Você só pode remover\nsuas aulas!")
            AC --> VUE : 500 Internal Server Error\n[sem tratamento no controller]
        else Aula pertence ao usuário
            AS -> AS : getAulaPorId(id)
            AS -> AR : findById(id)
            AR --> AS : Optional<Aula>

            alt #white S2 — Aula não encontrada
                AS --> AC : EntityNotFoundException\n("Aula não encontrada!")
                AC --> VUE : 500 Internal Server Error\n[sem tratamento no controller]
            else S3 — Aula já excluída
                AS -> AS : aula.getDataDelecao() != null
                AS --> AC : IllegalArgumentException\n("Aula já foi excluída!")
                AC --> VUE : 500 Internal Server Error\n[sem tratamento no controller]
            else Aula ativa
                AS -> AS : aula.setDataDelecao(now())
                AS -> AR : save(aula)
                AR --> AS : Aula (excluída logicamente)
                AS --> AC : true
                deactivate AS
                AC --> VUE : 204 No Content
                deactivate AC
            end
        end
deactivate VUE

@enduml
