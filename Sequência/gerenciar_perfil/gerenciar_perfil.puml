@startuml Gerenciar Perfil

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupFontStyle bold
skinparam noteFontSize 11
skinparam ParticipantFontStyle bold

title Diagrama de Sequência - Caso de Uso: Gerenciar Perfil\nMusicáudio v1.0

skinparam backgroundColor lightyellow

actor "Usuário" as USR

box "Camada Vue JS" #LightGreen
    boundary "Views JS" as VUE
end box

box "Camada de Segurança" #LightYellow
    participant "SecurityFilter\n(JWT)" as SEC
end box

box "Camada de Controle" #LightBlue
    control "ContaController" as CC
end box

box "Camada de Serviço" #LightPink
    entity "ContaService" as CS
end box

box "Camada de Persistência" #LightGrey
    database "CredencialRepository" as AR
    database "UsuarioRepository" as UR
end box

' FA1 - CADASTRAR PERFIL

== FA1: Cadastrar Perfil ==
note over USR: Pré-condição: não necessita\nestar autenticado

USR -> VUE : Cadastrar Usuário
activate VUE
VUE -> CC : POST /contas\n{ dados da conta }

activate CC

    CC -> CC : Bean Validation\n(@Validated(ContaRequestDTO.OnCreate.class))
    note right of CC: Validação de formato é feita\npelo Jakarta Validation no próprio DTO,\nantes do corpo do método ser executado.

    alt #white S0 - Campo obrigatório ausente / formato inválido
        CC --> VUE : 400 Bad Request\n{ erros de validação por campo }\n(tratado automaticamente pelo Spring)
    else Dados no formato válido
        CC -> CS : novaConta(dados)
        activate CS

            note over CS: criarConta(dados, permitirAdmin=false)\n(regras de negócio que a Bean\nValidation não cobre)

            CS -> AR : findByEmail(email)\n[verificação de e-mail já existente]
            AR --> CS : null / Credencial

            alt #white S1 - Email já cadastrado
                CS --> CC : Exception\n("Email já existe!")
                CC --> VUE : 400 Bad Request\n{ mensagem de erro }
            else Email disponível
                CS -> CS : passwordEncoder.encode(senha)
                CS -> CS : credencial.setAdmin(false)
                CS -> AR : save(credencial)
                AR --> CS : Credencial salva

                CS -> UR : findUsuarioByCpf(cpf)\n[verificação de CPF já cadastrado]
                UR --> CS : null / Usuario

                alt #WhiteSmoke S2 - CPF já cadastrado
                    CS --> CC : Exception\n("CPF já cadastrado!")
                    CC --> VUE : 400 Bad Request\n{ mensagem de erro }
                else CPF disponível
                    CS -> UR : save(usuario)
                    UR --> CS : Usuario salvo
                    CS --> CC : ContaResponseDTO
                    deactivate CS
                    CC --> VUE : 201 Created\n{ ContaResponseDTO }
                    deactivate CC
                end
            end
    end
deactivate VUE

' FA2 - VISUALIZAR PERFIL (usuário comum)

== FA2: Visualizar Perfil (Usuário Autenticado) ==
note over USR: Pré-condição: autenticado via JWT

USR -> VUE : Visualizar Perfil

activate VUE

VUE -> SEC : GET /contas/minha-conta\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem permissão
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : getContaPorEmail(emailLogado)
    activate CS
        CS -> AR : findByEmail(emailLogado)
        AR --> CS : Credencial

        CS -> UR : findUsuarioByCredencial_Id(credencialId)
        UR --> CS : Usuario

        alt #white S1 - Conta não encontrada
            CS --> CC : EntityNotFoundException\n("Não foi possível encontrar a conta")
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Conta encontrada
            CS --> CC : ContaResponseDTO
            deactivate CS
            CC --> VUE : 200 OK\n{ ContaResponseDTO }
        end
deactivate CC
deactivate VUE

' FA3 - EDITAR PERFIL (usuário comum)

== FA3: Editar Perfil (Usuário Autenticado) ==

USR -> VUE : Editar Perfil

activate VUE

VUE -> SEC : PUT /contas/minha-conta\nAuthorization: Bearer <token>\n{ dados atualizados }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem permissão
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : getContaPorEmail(emailLogado)
    activate CS
        CS -> AR : findByEmail(emailLogado)
        AR --> CS : Credencial
        CS -> UR : findUsuarioByCredencial_Id(credencialId)
        UR --> CS : Usuario
        CS --> CC : ContaResponseDTO\n(contém credencialId)
    deactivate CS

    CC -> CS : atualizarMinhaConta(credencialId, dados)
    activate CS
        note over CS: atualizarConta(credencialId, dados, minhaConta=true)

        CS -> AR : findById(credencialId)
        AR --> CS : Credencial atual

        CS -> UR : findUsuarioByCredencial_Id(credencialId)
        UR --> CS : Usuario atual

        CS -> CS : validarCredencial(credencialAtualizada, criando=false)
        CS -> CS : validarUsuario(usuarioAtualizado, criando=false)

        alt #white S1 - Conta deletada / dados inválidos
            CS --> CC : Exception\n("Não é possível alterar\ncredenciais/usuário deletados")
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            CS -> CS : atualiza campos da credencial\n(admin, email, senha se informada)
            CS -> CS : atualiza campos do usuário\n(nome, sobrenome, cpf, nascimento, telefone)

            CS -> AR : save(credencialAtual)
            AR --> CS : Credencial atualizada

            CS -> UR : save(usuarioAtual)
            UR --> CS : Usuario atualizado

            CS --> CC : ContaResponseDTO atualizado
            deactivate CS
            CC --> VUE : 200 OK\n{ ContaResponseDTO atualizado }
            deactivate CC
        end
deactivate VUE

' FA4 - REMOVER PERFIL (usuário comum)

== FA4: Remover Perfil (Usuário Autenticado) ==

note over USR, VUE: S4 - Confirmação de remoção:\nrecomenda-se confirmação no frontend\nantes de enviar a requisição

USR -> VUE : Excluir Conta
activate VUE

VUE -> SEC : DELETE /contas/minha-conta\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem permissão
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : getContaPorEmail(emailLogado)
    activate CS
        CS -> AR : findByEmail(emailLogado)
        AR --> CS : Credencial
        CS -> UR : findUsuarioByCredencial_Id(credencialId)
        UR --> CS : Usuario
        CS --> CC : ContaResponseDTO\n(contém credencialId)
    deactivate CS

    CC -> CS : apagarConta(credencialId)
    activate CS
        CS -> AR : findById(credencialId)
        AR --> CS : Credencial

        alt #white S1 - Credencial já excluída
            CS --> CC : Exception\n("Credencial já foi excluída!")
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Credencial ativa
            CS -> UR : findUsuarioByCredencial_Id(credencialId)
            UR --> CS : Usuario

            alt #WhiteSmoke S2 - Usuário já excluído
                CS --> CC : Exception\n("Usuário já foi excluído!")
                CC --> VUE : 400 Bad Request\n{ mensagem de erro }
            else Usuário ativo
                CS -> CS : credencial.setDataDelecao(now())
                CS -> CS : credencial.setEmail(email + "_deleted")
                CS -> CS : usuario.setDataDelecao(now())

                CS -> AR : save(credencial)
                AR --> CS : OK
                CS -> UR : save(usuario)
                UR --> CS : OK

                CS --> CC : true
                deactivate CS
                CC --> VUE : 204 No Content
                deactivate CC
            end
        end
deactivate VUE
@enduml
