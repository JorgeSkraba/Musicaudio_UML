@startuml Gerenciar Perfil Admin

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupFontStyle bold
skinparam noteFontSize 11
skinparam ParticipantFontStyle bold

title Diagrama de Sequêcnia - Caso de Uso: Gerenciar Perfil\nParte Admin\nMusicáudio v1.0

skinparam backgroundColor lightyellow

actor "Administrador" as ADM

box "Camada Vue JS" #LightGreen
    boundary "Views JS" as VUE
end box

box "Camada de Segurança" #LightYellow
    participant "SecurityFilter\n(JWT)" as SEC
end box

box "Camada de Controle" #LightBlue
    control "ContaAdminController" as CAC
end box

box "Camada de Serviço" #LightPink
    entity "ContaService" as CS
end box

box "Camada de Persistência" #LightGrey
    database "CredencialRepository" as AR
    database "UsuarioRepository" as UR
end box

' FA1-Admin - VISUALIZAR TODOS OS PERFIS

== FA1-Admin: Visualizar Todos os Perfis ==
note over ADM: Pré-condição: autenticado como ADMIN

ADM -> VUE: Visualizar Todas as Contas

activate VUE
    VUE -> SEC : GET /contas ? deleted & page & size & sortBy\nAuthorization: Bearer <token>

 activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem permissão
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CAC : repassa requisição autenticada
         deactivate SEC
         activate CAC
    end

    alt #white deleted = false
        CAC -> CS : getContasAtivas(page, size, sortBy)
        activate CS
            CS -> UR : findAll(pageable)\n[filtros "credencialAtivaFilter" e\n"usuarioAtivoFilter" habilitados]
            activate UR
            UR --> CS : Page<Usuario>
            deactivate UR
            CS -> CS : contaMapper.toAdminResponse
            CS --> CAC : Page<ContaResponseDTO>
        deactivate CS
    else deleted = true
        CAC -> CS : getContasDesativadas(page, size, sortBy)
        activate CS
            CS -> UR : findAllDeleted(pageable)\n[ambos os filtros desabilitados]
            activate UR
            UR --> CS : Page<Usuario>
            deactivate UR
            CS -> CS : contaMapper.toAdminResponse
            CS --> CAC : Page<ContaResponseDTO>
        deactivate CS
        
    end

    CAC --> VUE : 200 OK\n{ Page<ContaResponseDTO> }

    deactivate CAC
    deactivate VUE


' FA2-Admin - VISUALIZAR QUALQUER PERFIL

== FA2-Admin: Visualizar Qualquer Perfil ==

ADM -> VUE: Visualizar Qualquer Conta

activate VUE

VUE -> SEC : GET /contas/{id}\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem permissão
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CAC : repassa requisição autenticada
         deactivate SEC
         activate CAC
    end

   CAC -> CS : getContaPorId(id)
    activate CS
        CS -> AR : findById(id)
        activate AR
        AR --> CS : Credencial
        deactivate AR

        alt #white S1 — Credencial não encontrada
            CS --> CAC : EntityNotFoundException\n("Credencial não encontrada!")
            CAC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Credencial encontrada
            CS -> UR : findUsuarioByCredencial_Id(id)
            activate UR
            UR --> CS : Usuario
            deactivate UR
            CS --> CAC : ContaResponseDTO
            deactivate CS
            CAC --> VUE : 200 OK\n{ ContaResponseDTO }
        end
deactivate CAC
deactivate VUE

@enduml