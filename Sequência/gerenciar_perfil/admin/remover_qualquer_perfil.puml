@startuml Gerenciar Perfil Admin

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupFontStyle bold
skinparam noteFontSize 11
skinparam ParticipantFontStyle bold

title Diagrama de Sequêcnia - Caso de Uso: Gerenciar Perfil\nParte Admin\nMusicáudio v1.0

skinparam backgroundColor lightyellow

actor "Administrador" as ADM

box "Camada Vue JS" #LightGreen
    boundary "Views JS" as VUE
end box

box "Camada de Segurança" #LightYellow
    participant "SecurityFilter\n(JWT)" as SEC
end box

box "Camada de Controle" #LightBlue
    control "ContaAdminController" as CAC
end box

box "Camada de Serviço" #LightPink
    entity "ContaService" as CS
end box

box "Camada de Persistência" #LightGrey
    database "CredencialRepository" as AR
    database "UsuarioRepository" as UR
end box


' FA4-Admin - REMOVER QUALQUER PERFIL

== FA4-Admin: Remover Qualquer Perfil ==
ADM -> VUE : Remover Perfis

activate VUE

VUE -> SEC : DELETE /contas/{id}\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem permissão
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CAC : repassa requisição autenticada
         deactivate SEC
         activate CAC
    end

    CAC -> CS : apagarConta(id)
    activate CS
        CS -> AR : findById(id)
        activate AR
        AR --> CS : Credencial
        deactivate AR

        alt #white S1 — Credencial já excluída
            CS --> CAC : Exception\n("Credencial já foi excluída!")
            CAC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Credencial ativa
            CS -> UR : findUsuarioByCredencial_Id(id)
            activate UR
            UR --> CS : Usuario
            deactivate UR

            alt #WhiteSmoke S2 — Usuário já excluído
                CS --> CAC : Exception\n("Usuário já foi excluído!")
                CAC --> VUE : 400 Bad Request\n{ mensagem de erro }
            else Usuário ativo
                CS -> CS : credencial.setDataDelecao(now())
                CS -> CS : credencial.setEmail(email + "_deleted")
                CS -> CS : usuario.setDataDelecao(now())

                CS -> AR : save(credencial)
                activate AR
                AR --> CS : OK
                deactivate AR
                CS -> UR : save(usuario)
                activate UR
                UR --> CS : OK
                deactivate UR

                CS --> CAC : true
                deactivate CS
                CAC --> VUE : 204 No Content
                deactivate CAC
            end
        end
deactivate VUE

@enduml