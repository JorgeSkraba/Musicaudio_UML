@startuml Gerenciar Curso

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupFontStyle bold
skinparam noteFontSize 11
skinparam ParticipantFontStyle bold

title Diagrama de Sequência — Caso de Uso: Gerenciar Curso (Usuário Autenticado)\nMusicáudio v1.0

skinparam backgroundColor lightyellow

actor "Usuário" as USR

box "Camada Vue JS" #LightGreen
    boundary "Views JS" as VUE
end box

box "Camada de Segurança" #LightYellow
    participant "SecurityFilter\n(JWT)" as SEC
end box

box "Camada de Controle" #LightBlue
    control "CursoController" as CC
end box

box "Camada de Serviço" #LightPink
    entity "CursoService" as CS
end box

box "Camada de Persistência" #LightGrey
    database "CredencialRepository" as AR
    database "UsuarioRepository" as UR
    database "CursoRepository" as CR
end box

' FA1 — CADASTRAR CURSO

== FA1: Cadastrar Curso ==
note over USR: Pré-condição: autenticado via JWT

USR -> VUE : Cadastrar Curso
activate VUE

VUE -> SEC : POST /cursos/novo\nAuthorization: Bearer <token>\n{ dados do curso }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : criarCurso(emailLogado, curso)
    activate CS
        CS -> CS : validarCurso(curso)

        alt #white S1 — Dados obrigatórios não preenchidos
            CS --> CC : Exception\n("Nome/Nível do curso é obrigatório!")
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else S2 — Dados inválidos (ex: preço negativo)
            CS --> CC : Exception\n("Preço do curso precisa ser 0 ou mais!")
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            CS -> CS : curso.setStatus("RASCUNHO")

            CS -> AR : findByEmail(emailLogado)
            AR --> CS : Credencial

            CS -> UR : findUsuarioByCredencial_Id(credencialId)
            UR --> CS : Usuario

            CS -> CS : curso.setUsuario(usuario)

            CS -> CR : save(curso)
            CR --> CS : Curso salvo
            CS --> CC : Curso
                deactivate CS
            CC --> VUE : 201 Created\n{ CursoResponseDTO }
            deactivate CC
        end
deactivate VUE

' FA2 — EDITAR CURSO (Usuário Autenticado)

== FA2: Editar Meu Curso ==
note over USR: Pré-condição: autenticado via JWT;\no curso deve pertencer ao usuário

USR -> VUE : Editar Meu Curso
activate VUE

VUE -> SEC : PUT /cursos/meus-cursos/{id}\nAuthorization: Bearer <token>\n{ dados atualizados }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : atualizarCurso(id, cursoAtualizado, emailLogado, admin=false)
    activate CS
        CS -> CS : validarCurso(cursoAtualizado)

        alt #WhiteSmoke S1 — Dados obrigatórios não preenchidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else S2 — Dados inválidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            CS -> CR : findById(id)
            CR --> CS : Curso

            note over CS: validarPertenceAoUsuario(cursoAtualizado, emailLogado)
            CS -> AR : findByEmail(emailLogado)
            AR --> CS : Credencial

            CS -> UR : findUsuarioByCredencial_Id(credencialId)
            UR --> CS : Usuario

            alt #white S3 — Curso não pertence ao usuário logado
                CS --> CC : AccessDeniedException\n("Você só pode realizar operações\nem seus próprios cursos!")
                CC --> VUE : 403 Forbidden
            else Curso pertence ao usuário
                CS -> CS : atualiza nome, descrição,\npreço, nível e status
                CS -> CR : save(curso)
                CR --> CS : Curso atualizado
                CS --> CC : Curso
                     deactivate CS
                 CC --> VUE : 200 OK\n{ CursoResponseDTO atualizado }
                   deactivate CC
            end
        end
deactivate VUE

' FA3 — PUBLICAR CURSO

== FA3: Publicar Curso ==
note over USR: Pré-condição: autenticado; curso pertence ao usuário.\nPublicar equivale a uma atualização do curso\nalterando apenas o campo "status" para "PUBLICADO".\n(Funcionalidade ainda não implementada — fluxo previsto)

USR -> VUE : Publicar Curso
activate VUE

VUE -> SEC : PUT /cursos/meus-cursos/{id}\nAuthorization: Bearer <token>\n{ ..., status: "PUBLICADO" }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : atualizarCurso(id, cursoAtualizado, emailLogado, admin=false)
    activate CS
        CS -> CS : validarCurso(cursoAtualizado)

        alt #WhiteSmoke S1 — Dados obrigatórios não preenchidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            CS -> CR : findById(id)
            CR --> CS : Curso

            note over CS: validarPertenceAoUsuario(cursoAtualizado, emailLogado)
            CS -> AR : findByEmail(emailLogado)
            AR --> CS : Credencial

            CS -> UR : findUsuarioByCredencial_Id(credencialId)
            UR --> CS : Usuario

            alt #white S2 — Curso não pertence ao usuário logado
                CS --> CC : AccessDeniedException
                CC --> VUE : 403 Forbidden
            else Curso pertence ao usuário
                CS -> CS : curso.setStatus("PUBLICADO")\n(demais campos mantidos/atualizados)
                CS -> CR : save(curso)
                CR --> CS : Curso atualizado
                CS --> CC : Curso
                     deactivate CS
                 CC --> VUE : 200 OK\n{ CursoResponseDTO com status PUBLICADO }
                   deactivate CC
            end
        end
deactivate VUE
note over VUE: Curso passa a ficar visível\npara outros usuários

' FA4 — DESPUBLICAR CURSO

== FA4: Despublicar Curso ==
note over USR: Pré-condição: autenticado; curso pertence ao usuário\ne está publicado. Despublicar equivale a uma\natualização do curso alterando o campo "status"\npara "RASCUNHO". (Funcionalidade ainda não\nimplementada — fluxo previsto)

USR -> VUE : Despublicar Curso
activate VUE

VUE -> SEC : PUT /cursos/meus-cursos/{id}\nAuthorization: Bearer <token>\n{ ..., status: "RASCUNHO" }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : atualizarCurso(id, cursoAtualizado, emailLogado, admin=false)
    activate CS
        CS -> CS : validarCurso(cursoAtualizado)

        alt #WhiteSmoke S1 — Dados obrigatórios não preenchidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            CS -> CR : findById(id)
            CR --> CS : Curso

            note over CS: validarPertenceAoUsuario(cursoAtualizado, emailLogado)
            CS -> AR : findByEmail(emailLogado)
            AR --> CS : Credencial

            CS -> UR : findUsuarioByCredencial_Id(credencialId)
            UR --> CS : Usuario

            alt #white S2 — Curso não pertence ao usuário logado
                CS --> CC : AccessDeniedException
                CC --> VUE : 403 Forbidden
            else Curso pertence ao usuário
                CS -> CS : curso.setStatus("RASCUNHO")\n(demais campos mantidos/atualizados)
                CS -> CR : save(curso)
                CR --> CS : Curso atualizado
                CS --> CC : Curso
                     deactivate CS
                 CC --> VUE : 200 OK\n{ CursoResponseDTO com status RASCUNHO }
                   deactivate CC
            end
        end
deactivate VUE
note over VUE: Curso removido da área pública;\npermanece acessível na área\nde gerenciamento do usuário\nalém de ser visualizado por\nquem comprou

' FA5 — REMOVER CURSO (Usuário Autenticado)

== FA5: Remover Meu Curso ==
note over USR: Pré-condição: autenticado;\ncurso pertence ao usuário

USR -> VUE : Remover Meu Curso
activate VUE

VUE -> SEC : DELETE /cursos/meus-cursos/{id}\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : apagarCurso(id, emailLogado, admin=false)
    activate CS
        CS -> CR : findById(id)
        CR --> CS : Curso

        alt #white S1 — Curso não encontrado
            CS --> CC : EntityNotFoundException\n("Curso não foi achado!")
            CC --> VUE : 404 Not Found
        else S2 — Curso já excluído
            CS --> CC : IllegalArgumentException\n("Curso já foi excluído!")
            CC --> VUE : 400 Bad Request
        else Curso encontrado e ativo
            note over CS: validarPertenceAoUsuario(curso, emailLogado)
            CS -> AR : findByEmail(emailLogado)
            AR --> CS : Credencial

            CS -> UR : findUsuarioByCredencial_Id(credencialId)
            UR --> CS : Usuario

            alt #white S3 — Curso não pertence ao usuário logado
                CS --> CC : AccessDeniedException
                CC --> VUE : 403 Forbidden
            else S2 - Curso já excluído
                CR --> CS : Curso (dataDelecao != null)
                CS --> CC : IllegalArgumentException\n("Curso já foi excluído!")
                CC --> VUE : 400 Bad Request\n{ "Curso já foi excluído!" }
            else Curso pertence ao usuário
                CS -> CS : curso.setDataDelecao(now())
                CS -> CR : save(curso)
                CR --> CS : Curso (excluído logicamente)
                CS --> CC : true
                deactivate CS
                CC --> VUE : 204 No Content
                deactivate CC
            end
        end
deactivate VUE

@enduml
