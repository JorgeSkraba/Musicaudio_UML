@startuml Gerenciar Curso

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupFontStyle bold
skinparam noteFontSize 11
skinparam ParticipantFontStyle bold

title Diagrama de Sequência — Caso de Uso: Gerenciar Curso (Usuário Autenticado)\nMusicáudio v1.0

skinparam backgroundColor lightyellow

actor "Usuário" as USR

box "Camada Vue JS" #LightGreen
    boundary "Views JS" as VUE
end box

box "Camada de Segurança" #LightYellow
    participant "SecurityFilter\n(JWT)" as SEC
end box

box "Camada de Controle" #LightBlue
    control "CursoController" as CC
end box

box "Camada de Serviço" #LightPink
    entity "CursoService" as CS
end box

box "Camada de Persistência" #LightGrey
    database "CredencialRepository" as AR
    database "UsuarioRepository" as UR
    database "CursoRepository" as CR
end box

' FA3 — PUBLICAR CURSO

== FA3: Publicar Curso ==
note over USR: Pré-condição: autenticado; curso pertence ao usuário.\nPublicar equivale a uma atualização do curso\nalterando apenas o campo "status" para "PUBLICADO".\n(Funcionalidade ainda não implementada — fluxo previsto)

USR -> VUE : Publicar Curso
activate VUE

VUE -> SEC : PUT /cursos/meus-cursos/{id}\nAuthorization: Bearer <token>\n{ ..., status: "PUBLICADO" }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : atualizarCurso(id, cursoAtualizado, emailLogado, admin=false)
    activate CS
        CS -> CS : validarCurso(cursoAtualizado)

        alt #WhiteSmoke S1 — Dados obrigatórios não preenchidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            CS -> CR : findById(id)
            activate CR
            CR --> CS : Curso
            deactivate CR

            note over CS: validarPertenceAoUsuario(cursoAtualizado, emailLogado)
            CS -> AR : findByEmail(emailLogado)
            activate AR
            AR --> CS : Credencial
            deactivate AR

            CS -> UR : findUsuarioByCredencial_Id(credencialId)
            activate UR
            UR --> CS : Usuario
            deactivate UR

            alt #white S2 — Curso não pertence ao usuário logado
                CS --> CC : AccessDeniedException
                CC --> VUE : 403 Forbidden
            else Curso pertence ao usuário
                CS -> CS : curso.setStatus("PUBLICADO")\n(demais campos mantidos/atualizados)
                CS -> CR : save(curso)
                activate CR
                CR --> CS : Curso atualizado
                deactivate CR
                CS --> CC : Curso
                     deactivate CS
                 CC --> VUE : 200 OK\n{ CursoResponseDTO com status PUBLICADO }
                   deactivate CC
            end
        end
deactivate VUE
note over VUE: Curso passa a ficar visível\npara outros usuários

' FA4 — DESPUBLICAR CURSO

== FA4: Despublicar Curso ==
note over USR: Pré-condição: autenticado; curso pertence ao usuário\ne está publicado. Despublicar equivale a uma\natualização do curso alterando o campo "status"\npara "RASCUNHO". (Funcionalidade ainda não\nimplementada — fluxo previsto)

USR -> VUE : Despublicar Curso
activate VUE

VUE -> SEC : PUT /cursos/meus-cursos/{id}\nAuthorization: Bearer <token>\n{ ..., status: "RASCUNHO" }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 — Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : atualizarCurso(id, cursoAtualizado, emailLogado, admin=false)
    activate CS
        CS -> CS : validarCurso(cursoAtualizado)

        alt #WhiteSmoke S1 — Dados obrigatórios não preenchidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            CS -> CR : findById(id)
            activate CR
            CR --> CS : Curso
            deactivate CR

            note over CS: validarPertenceAoUsuario(cursoAtualizado, emailLogado)
            CS -> AR : findByEmail(emailLogado)
            activate AR
            AR --> CS : Credencial
            deactivate AR

            CS -> UR : findUsuarioByCredencial_Id(credencialId)
            activate UR
            UR --> CS : Usuario
            deactivate UR

            alt #white S2 — Curso não pertence ao usuário logado
                CS --> CC : AccessDeniedException
                CC --> VUE : 403 Forbidden
            else Curso pertence ao usuário
                CS -> CS : curso.setStatus("RASCUNHO")\n(demais campos mantidos/atualizados)
                CS -> CR : save(curso)
                activate CR
                CR --> CS : Curso atualizado
                deactivate CR
                CS --> CC : Curso
                     deactivate CS
                 CC --> VUE : 200 OK\n{ CursoResponseDTO com status RASCUNHO }
                   deactivate CC
            end
        end
deactivate VUE
note over VUE: Curso removido da área pública;\npermanece acessível na área\nde gerenciamento do usuário\nalém de ser visualizado por\nquem comprou
@enduml