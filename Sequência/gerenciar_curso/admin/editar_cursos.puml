@startuml Gerenciar Curso

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupFontStyle bold
skinparam noteFontSize 11
skinparam ParticipantFontStyle bold

title Diagrama de Sequência - Caso de Uso: Gerenciar Curso\nParte Admin\nMusicáudio v1.0

skinparam backgroundColor lightyellow

actor "Administrador" as ADM

box "Camada Vue JS" #LightGreen
    boundary "Views JS" as VUE
end box

box "Camada de Segurança" #LightYellow
    participant "SecurityFilter\n(JWT)" as SEC
end box

box "Camada de Controle" #LightBlue
    control "CursoController" as CC
end box

box "Camada de Serviço" #LightPink
    entity "CursoService" as CS
end box

box "Camada de Persistência" #LightGrey
    database "CursoRepository" as CR
end box

' FA3-Admin - EDITAR QUALQUER CURSO

== FA3-Admin: Editar Qualquer Curso ==
note over ADM: Pré-condição: autenticado como ADMIN.\nComo admin=true, a verificação de\npertencimento ao usuário é ignorada.

ADM -> VUE : Editar Curso
activate VUE

VUE -> SEC : PUT /cursos/{id}\nAuthorization: Bearer <token>\n{ dados atualizados }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : atualizarCurso(id, cursoAtualizado, emailLogado, admin=true)
    activate CS
        CS -> CS : validarCurso(cursoAtualizado)

        alt #white S1 - Dados obrigatórios não preenchidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else S2 - Dados inválidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            CS -> CR : findById(id)
            activate CR
            CR --> CS : Curso atual
            deactivate CR

            note over CS: admin = true\n→ validarPertenceAoUsuario NÃO é chamada

            CS -> CS : atualiza nome, descrição,\npreço, nível e status
            CS -> CR : save(curso)
            activate CR
            CR --> CS : Curso atualizado
            deactivate CR
            CS --> CC : Curso
               deactivate CS
            CC --> VUE : 200 OK\n{ CursoResponseDTO atualizado }
            deactivate CC
        end
deactivate VUE

@enduml