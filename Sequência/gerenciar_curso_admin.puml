@startuml Gerenciar Curso

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupFontStyle bold
skinparam noteFontSize 11
skinparam ParticipantFontStyle bold

title Diagrama de Sequência - Caso de Uso: Gerenciar Curso\nParte Admin\nMusicáudio v1.0

skinparam backgroundColor lightyellow

actor "Administrador" as ADM

box "Camada Vue JS" #LightGreen
    boundary "Views JS" as VUE
end box

box "Camada de Segurança" #LightYellow
    participant "SecurityFilter\n(JWT)" as SEC
end box

box "Camada de Controle" #LightBlue
    control "CursoController" as CC
end box

box "Camada de Serviço" #LightPink
    entity "CursoService" as CS
end box

box "Camada de Persistência" #LightGrey
    database "CursoRepository" as CR
end box

' FA1-Admin - LISTAR CURSOS (ATIVOS/DESATIVADOS, PAGINADO)

== FA1-Admin: Listar Cursos ==
note over ADM: Pré-condição: autenticado como ADMIN

ADM -> VUE : Listar Cursos
activate VUE

VUE -> SEC : GET /cursos ? deleted & page & size & sortBy\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    alt #white deleted = false
        CC -> CS : getCursosAtivos(page, size, sortBy)
        activate CS
            CS -> CR : findAll(pageable)\n[filtro "cursoAtivoFilter" habilitado]
            CR --> CS : Page<Curso>
        deactivate CS
    else deleted = true
        CC -> CS : getCursosDesativados(page, size, sortBy)
        activate CS
            CS -> CR : findAllDeleted(pageable)\n[filtro "cursoAtivoFilter" desabilitado]
            CR --> CS : Page<Curso>
            CS-->CC : Page<CursoResponseDTO>
        deactivate CS
    end

    CC --> VUE : 200 OK\n{ Page<CursoResponseDTO> }
deactivate CC
deactivate VUE

' FA2-Admin - LISTAR CURSO POR ID

== FA2-Admin: Buscar Curso por Id ==

ADM -> VUE : Visualizar Curso por Id
activate VUE
VUE -> SEC : GET /cursos/{id}\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end
CC -> CS : getCursoPorId(id)
activate CS
CS -> CR : findById(id)
    alt #white S1 - Curso não encontrado
            CR --> CS : Optional.empty()
            CS --> CC : EntityNotFoundException\n("Curso não encontrado!")
            CC --> VUE : 404 Not Found\n{ "Curso não encontrado!" }
    else Curso existe
        CR --> CS : Curso
        CS --> CC : Curso
        deactivate CS
        CC --> VUE : 200 OK\n{ CursoResponseDTO }
        deactivate CC
    end
deactivate VUE

' FA3-Admin - EDITAR QUALQUER CURSO

== FA3-Admin: Editar Qualquer Curso ==
note over ADM: Pré-condição: autenticado como ADMIN.\nComo admin=true, a verificação de\npertencimento ao usuário é ignorada.

ADM -> VUE : Editar Curso
activate VUE

VUE -> SEC : PUT /cursos/{id}\nAuthorization: Bearer <token>\n{ dados atualizados }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : atualizarCurso(id, cursoAtualizado, emailLogado, admin=true)
    activate CS
        CS -> CS : validarCurso(cursoAtualizado)

        alt #white S1 - Dados obrigatórios não preenchidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else S2 - Dados inválidos
            CS --> CC : Exception\n(mensagem de validação)
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            CS -> CR : findById(id)
            CR --> CS : Curso atual

            note over CS: admin = true\n→ validarPertenceAoUsuario NÃO é chamada

            CS -> CS : atualiza nome, descrição,\npreço, nível e status
            CS -> CR : save(curso)
            CR --> CS : Curso atualizado
            CS --> CC : Curso
               deactivate CS
            CC --> VUE : 200 OK\n{ CursoResponseDTO atualizado }
            deactivate CC
        end
deactivate VUE

' FA4-Admin - REMOVER QUALQUER CURSO

== FA4-Admin: Remover Qualquer Curso ==
note over ADM: Pré-condição: autenticado como ADMIN.\nComo admin=true, a verificação de\npertencimento ao usuário é ignorada.

ADM -> VUE : Remover Curso
activate VUE

VUE -> SEC : DELETE /cursos/{id}\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem autenticação
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> CS : apagarCurso(id, emailLogado, admin=true)
    activate CS
        CS -> CR : findById(id)

        alt #white S1 - Curso não encontrado
            CR --> CS : Optional.empty()
            CS --> CC : EntityNotFoundException\n("Curso não foi achado!")
            CC --> VUE : 404 Not Found\n{ "Curso não foi achado!" }
        else S2 - Curso já excluído
            CR --> CS : Curso (dataDelecao != null)
            CS --> CC : IllegalArgumentException\n("Curso já foi excluído!")
            CC --> VUE : 400 Bad Request\n{ "Curso já foi excluído!" }
        else Curso encontrado e ativo
            CR --> CS : Curso

            note over CS: admin = true\n→ validarPertenceAoUsuario NÃO é chamada

            CS -> CS : curso.setDataDelecao(now())
            CS -> CR : save(curso)
            CR --> CS : Curso (excluído logicamente)
            CS --> CC : true
               deactivate CS
            CC --> VUE : 204 No Content
               deactivate CC
        end
deactivate VUE

@enduml
