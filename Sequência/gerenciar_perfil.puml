@startuml Gerenciar Perfil

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupFontStyle bold
skinparam noteFontSize 11
skinparam ParticipantFontStyle bold

title Diagrama de Sequência - Caso de Uso: Gerenciar Perfil\nMusicáudio v1.0

actor "Usuário" as USR

box "Camada Vue JS" #LightGreen
    boundary "Views JS" as VUE
end box

box "Camada de Segurança" #LightYellow
    participant "SecurityFilter\n(JWT)" as SEC
end box

box "Camada de Controle" #LightBlue
    control "ContaController" as CC
end box

box "Camada de Serviço" #LightPink
    entity "AutenticacaoService" as AS
    entity "UsuarioService" as US
end box

box "Camada de Persistência" #LightGrey
    database "AutenticacaoRepository" as AR
    database "UsuarioRepository" as UR
end box

' FA1 - CADASTRAR PERFIL

== FA1: Cadastrar Perfil ==
note over USR: Pré-condição: não necessita\nestar autenticado

USR -> VUE : Cadastrar Usuário
activate VUE
VUE -> CC : POST /contas

activate CC

    CC -> AS : novaAutenticacao(autenticacao)
    activate AS

        AS -> AS : validarAutenticacao(autenticacao)

        alt #white S1 - Dados obrigatórios não informados
            AS --> CC : IllegalArgumentException\n("Email/Senha é obrigatório!")
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else S2 - Dados inválidos
            AS --> CC : IllegalArgumentException
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            AS -> AS : passwordEncoder.encode(senha)
            AS -> AS : autenticacao.setAdmin(false)
            AS -> AR : save(autenticacao)
            AR --> AS : Autenticacao salva
            AS --> CC : Autenticacao
       
    deactivate AS

    CC -> US : novoUsuario(usuario)

   activate US

        US -> US : validarUsuario(usuario)
         alt #WhiteSmoke S1 - Dados obrigatórios não informados
            US --> CC : IllegalArgumentException
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
         US -> UR : save(usuario)
         UR --> US : Usuario salvo
         US --> CC : Usuario
          deactivate US
             CC --> VUE : 201 Created\n{ ContaResponseDTO }
             deactivate CC
        end
    end
deactivate VUE
' FA2 - VISUALIZAR PERFIL (usuário comum)

== FA2: Visualizar Perfil (Usuário Autenticado) ==
note over USR: Pré-condição: autenticado via JWT

USR -> VUE : Visualizar Perfil

activate VUE

VUE -> SEC : GET /contas/minha-conta\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem permissão
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> AS : buscarAutenticacaoPorEmail(email)
    activate AS
        AS -> AR : findByEmail(email)
        AR --> AS : Autenticacao
        AS --> CC : Autenticacao
    deactivate AS

    CC -> US : getUsuarioPorAutenticacao(autenticacaoId)
    activate US
        US -> UR : findByAutenticacaoId(id)
        UR --> US : Usuario
        US --> CC : Usuario
    deactivate US

    CC --> VUE : 200 OK\n{ ContaResponseDTO }
deactivate CC

deactivate VUE

' FA3 - EDITAR PERFIL (usuário comum)

== FA3: Editar Perfil (Usuário Autenticado) ==

USR -> VUE : Editar Perfil

activate VUE

VUE -> SEC : PUT /contas/minha-conta\nAuthorization: Bearer <token>\n{ dados atualizados }
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem permissão
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

    CC -> AS : atualizarMinhaAutenticacao(emailLogado, autenticacaoAtualizada)
    activate AS
        AS -> AR : findByEmail(emailLogado)
        AR --> AS : Autenticacao atual
        AS -> AS : validarAutenticacao(autenticacaoAtualizada)

        alt #white S1 - Dados obrigatórios não informados
            AS --> CC : IllegalArgumentException
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else S2 - Dados inválidos
            AS --> CC : IllegalArgumentException
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos
            AS -> AS : passwordEncoder.encode(novaSenha)\n[se senha informada]
            AS -> AR : save(autenticacao)
            AR --> AS : Autenticacao atualizada
            AS --> CC : Autenticacao
    deactivate AS

    CC -> US : getUsuarioPorAutenticacao(autenticacaoId)
    activate US
        US -> UR : findByAutenticacaoId(id)
        UR --> US : Usuario atual
        US --> CC : Usuario
        CC -> US : atualizarUsuario(usuarioId, usuarioAtualizado)

            US -> US : validarUsuario(usuarioAtualizado)
         alt #WhiteSmoke S1 - Dados obrigatórios não informados
            US --> CC : IllegalArgumentException
            CC --> VUE : 400 Bad Request\n{ mensagem de erro }
        else Dados válidos

        US -> UR : save(usuarioAtualizado)
        UR --> US : Usuario atualizado
        US --> CC : Usuario
    deactivate US

    CC --> VUE : 200 OK\n{ ContaResponseDTO atualizado }
    deactivate CC
    end
 end
deactivate VUE
' FA4 - REMOVER PERFIL (usuário comum)

== FA4: Remover Perfil (Usuário Autenticado) ==

note over USR, VUE: S4 - Confirmação de remoção:\nrecomenda-se confirmação no frontend\nantes de enviar a requisição

USR -> VUE : Excluir Conta
activate VUE

VUE -> SEC : DELETE /contas/minha-conta\nAuthorization: Bearer <token>
activate SEC
    SEC -> SEC : recuperarToken(request)
    SEC -> SEC : tokenService.validarToken(token)

    alt #white S1 - Token inválido / sem permissão
        SEC --> VUE : 403 Forbidden
    else Token válido
        SEC -> SEC : SecurityContextHolder\n.setAuthentication(auth)
        SEC -> CC : repassa requisição autenticada
         deactivate SEC
         activate CC
    end

activate CC

    CC -> AS : buscarAutenticacaoPorEmail(email)
    activate AS
        AS -> AR : findByEmail(email)
        AR --> AS : Autenticacao
        AS --> CC : Autenticacao
    deactivate AS

    CC -> US : getUsuarioPorAutenticacao(autenticacaoId)
    activate US
        US -> UR : findByAutenticacaoId(id)
        UR --> US : Usuario
        US --> CC : Usuario
    deactivate US

    CC -> US : apagarUsuario(usuarioId)
    activate US
        US -> UR : deleteById(usuarioId)
        UR --> US : OK
        US --> CC : true
    deactivate US

    CC -> AS : apagarAutenticacao(autenticacaoId)
    activate AS
        AS -> AR : deleteById(autenticacaoId)
        AR --> AS : OK
        AS --> CC : true
    deactivate AS

    CC --> VUE : 204 No Content
deactivate CC
deactivate VUE
@enduml