        +apagarAula(id: Long): Boolean
    }

    class AulaServiceImp <<Service>> {
        -aulaRepository: AulaRepository
        -cursoRepository: CursoRepository
        +criarAula(cursoId: Long, aula: Aula): Aula
        -validarCursoExistente(cursoId: Long): void
        +getAulasPorCurso(cursoId: Long): List<Aula>
        +getAulaPorId(id: Long): Aula
        +atualizarAula(id: Long, aulaAtualizada: Aula): Aula
        +ativarDesativarAula(id: Long, ativo: boolean): Aula
        +apagarAula(id: Long): Boolean
    }

    'MATERIAL
    interface MaterialService {
        +criarMaterial(aulaId: Long, material: Material): Material
        +getMateriaisPorAula(aulaId: Long): List<Material>
        +getMaterialPorId(id: Long): Material
        +atualizarMaterial(id: Long, material: Material): Material
        +ativarDesativarMaterial(id: Long, ativo: boolean): Material
        +apagarMaterial(id: Long): Boolean
    }

    class MaterialServiceImp <<Service>> {
        -materialRepository: MaterialRepository
        -aulaRepository: AulaRepository
        +criarMaterial(aulaId: Long, material: Material): Material
        -validarAulaExistente(aulaId: Long): void
        -validarTipoArquivo(tipo: String): void
        +getMateriaisPorAula(aulaId: Long): List<Material>
        +getMaterialPorId(id: Long): Material
        +atualizarMaterial(id: Long, materialAtualizado: Material): Material
        +ativarDesativarMaterial(id: Long, ativo: boolean): Material
        +apagarMaterial(id: Long): Boolean
    }

    'COMPRA
    interface CompraService {
        +iniciarCompra(usuarioId: Long): Compra
        +adicionarItem(compraId: Long, cursoId: Long): Compra
        +finalizarCompra(compraId: Long): Compra
        +getComprasPorUsuario(usuarioId: Long): List<Compra>
        +getCompraPorId(id: Long): Compra
        +cancelarCompra(id: Long): Boolean
    }

    class CompraServiceImp <<Service>> {
        -compraRepository: CompraRepository
        -itemCompraRepository: ItemCompraRepository
        -cursoRepository: CursoRepository
        +iniciarCompra(usuarioId: Long): Compra
        +adicionarItem(compraId: Long, cursoId: Long): Compra
        -calcularValorTotal(compraId: Long): float
        -validarCursoNaoDuplicado(compraId: Long, cursoId: Long): void
