        +getComprasPorUsuario(usuarioId: Long): List<Compra>
        +getCompraPorId(id: Long): Compra
        +cancelarCompra(id: Long): Boolean
    }

    'PAGAMENTO
    interface PagamentoService {
        +processarPagamento(compraId: Long, pagamento: Pagamento): Pagamento
        +getPagamentoPorId(id: Long): Pagamento
