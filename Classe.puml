'PINIA STORE
package "stores"{

    'AUTH
    class authStore <<Pinia Store>> {
        -token: Ref<String>
        +isAuthenticated: Computed<Boolean>
        +setToken(newToken): void
        +logout(): void
    }

    'CURSO
    class cursoStore <<Pinia Store>> {
        -cursoAtual: Ref<CursoResponseDTO>
        -cursosInstrutor: Ref<CursoResponseDTO[]>
        +setCursoAtual(curso): void
        +setCursosInstrutor(cursos): void
        +limpar(): void
    }

    'CARRINHO 
    class carrinhoStore <<Pinia Store>> {
        -itens: Ref<CursoResponseDTO[]>
        -compraIdAtual: Ref<Long>
        +totalItens: Computed<Number>
        +valorTotal: Computed<Float>
        +adicionarAoCarrinho(curso): void
        +removerDoCarrinho(cursoId): void
        +setCompraId(id): void
        +limpar(): void
    }

    'MATRICULA
    class matriculaStore <<Pinia Store>> {
        -matriculas: Ref<MatriculaResponseDTO[]>
        +cursosMatriculados: Computed<Long[]>
        +setMatriculas(lista): void
        +estaMatriculado(cursoId): Boolean
        +limpar(): void
    }

}

'ROUTER
package "router" {

    class Router <<Vue Router>> {
        ' ── públicas ─────────────────────────
        +/login → LoginView
        +/cadastro → RegisterView
        ' ── privadas (requiresAuth) ──────────
        +/usuarios → UsersListView
        +/usuarios/novo → UserCreateView
        +/usuarios/editar/:id → UserEditView
        +/cursos → CursosListView
        +/cursos/novo → CursoCreateView
        +/cursos/:id → CursoDetailView
        +/cursos/:id/editar → CursoEditView
        +/cursos/:id/aulas/nova → AulaCreateView
        +/cursos/:id/aulas/:aulaId/editar → AulaEditView
        +/cursos/:id/aulas/:aulaId/materiais/novo → MaterialCreateView
        +/cursos/:id/aulas/:aulaId/materiais/:matId/editar → MaterialEditView
        +/carrinho → CarrinhoView
        +/compras/:id/pagamento → PagamentoView
        +/meus-cursos → MeusCursosView
        +/admin/matriculas → MatriculasAdminView
        +beforeEach(): verificaToken
    }
}

