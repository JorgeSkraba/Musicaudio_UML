        +getMatriculasPorUsuario(usuarioId: Long): List<Matricula>
        +getMatriculaPorId(id: Long): Matricula
        +verificarMatricula(usuarioId: Long, cursoId: Long): boolean
        +ativarDesativarMatricula(id: Long, ativo: boolean): Matricula
        +apagarMatricula(id: Long): Boolean
    }


    class PapelService <<Service>> {
        -papelRepository: PapelRepository
        +salvarPapel(papel: Papel): Papel
        +getPapeis(): List<Papel>
    }

    class TokenService <<Service>> {
        -secretKey: String
        +gerarToken(subject: String): String
        +validarToken(token: String): String
    }
}

package "security" {

    class CustomUserDetails {
        -usuarioService: UsuarioService
        +CustomUserDetails(usuarioService: UsuarioService)
        +loadUserByUsername(identificador: String): UserDetails
    }

    class SecurityFilter <<Component>> {
        -tokenService: TokenService
        -userDetailsService: UserDetailsService
        +doFilterInternal(request: HttpServletRequest, response: HttpServletResponse, filterChain: FilterChain): void
        -recuperarToken(request: HttpServletRequest): String
    }

    class FilterChainConfig <<Configuration>> {
        +securityFilterChain(http: HttpSecurity, filter: SecurityFilter): SecurityFilterChain
        +passwordEncoder(): PasswordEncoder
        +authencationManager(configuration: AuthenticationConfiguration): AuthenticationManager
        +userDetailsService(usuarioService: UsuarioService): UserDetailsService
        +corsConfigurationSource(): CorsConfigurationSource
    }
}

